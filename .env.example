# tapedeck needs NO credentials to replay. Recording uses whatever login your real agent CLI
# already has (e.g. `claude` logged in). All settings below are optional; the pytest fixture
# and `tapedeck exec` set the first four for you.

# TAPEDECK_CASSETTE=tests/cassettes/run.json   # cassette path (required for bare shims)
# TAPEDECK_MODE=replay                         # once | replay | record | new | passthrough
# TAPEDECK_STATE=                              # session state file (consumption order across calls)
# TAPEDECK_LOG=                                # JSONL log of intercepted calls
# TAPEDECK_SPEED=0                             # 0 = instant, 1 = recorded pace
# TAPEDECK_FAULT=                              # hang | truncate:N | exit:N | delay:S | drop-effects, optional @K
# TAPEDECK_IGNORE_FLAGS=--session-id,--resume,-r   # flags whose values are volatile
# TAPEDECK_MATCH=argv,stdin                    # request fields that must match
# TAPEDECK_EFFECTS=1                           # 0 = do not record/replay file changes
# TAPEDECK_REPEAT=1                            # 0 = error once matching recordings are used up
# TAPEDECK_STDIN_TIMEOUT=2                     # seconds to wait on a silent, never-closed stdin
# TAPEDECK_REDACT=                             # extra literal strings to redact, comma-separated
